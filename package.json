{
  "name": "zorveus-write-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "dev:base": "node --import tsx server/index.ts --base",
    "build": "tsc --noEmit && vite build && node scripts/check-browser.mjs",
    "start": "node --import tsx server/index.ts --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "preflight": "node --import tsx scripts/preflight.ts",
    "package": "node scripts/package.mjs",
    "test:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@zorveus/sdk": "0.4.2",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  }
}
