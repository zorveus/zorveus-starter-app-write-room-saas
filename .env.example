# Server-only configuration. Copy to .env and fill in your own applied values.
# The app reads .env or process environment values; it does not access the CLI store.
# Always configure both endpoints for local or alternate environments.
ZORVEUS_API_BASE_URL=https://api.zorveus.com
ZORVEUS_GATEWAY_URL=https://api.zorveus.com/v1
# Applied app ID, customer service key with product_users:read and product_users:write, and one direct inference key for each plan.
ZORVEUS_APP_ID=
ZORVEUS_SERVICE_KEY=
# The server selects keys.plus for Alex and keys.plus_ultra for Sam.
ZORVEUS_PLUS_INFERENCE_KEY=
ZORVEUS_PLUS_ULTRA_INFERENCE_KEY=
# Optional override, also allow it in zorveus.json and review plan/apply.
ZORVEUS_MODEL_ID=gemini/gemini-3.5-flash-lite
# PORT=3000
